# Local-only Airflow + dlt demo settings. Copy to infra/local/.env and edit there.
AIRFLOW_UID=50000
DOCKER_GID=998
EVE_MARKET_INGESTION_IMAGE=eve-market-ingestion:local
EVE_MARKET_INGESTION_FORCE_PULL=false
EVE_MARKET_LOCAL_DATA_HOST_PATH=/home/rnoh/dev/eve-market/.local/data
INGESTION_APP_UID=10001
INGESTION_APP_GID=10001

POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow-local-only
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432

# Local raw file ledger DB. Same Postgres container, separate database/user/password.
RAW_FILES_POSTGRES_PASSWORD=password

# Local demo keys only. Replace in infra/local/.env if this leaves your laptop.
AIRFLOW_FERNET_KEY=MDEyMzQ1Njc4OUFCQ0RFRjAxMjM0NTY3ODlBQkNERUY=
AIRFLOW_API_SECRET_KEY=airflow-local-api-secret-change-me

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
